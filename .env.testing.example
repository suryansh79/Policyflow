# Copy this to .env.testing to run tests against MySQL instead of SQLite in-memory
# Command: php artisan test --env=testing

APP_ENV=testing
APP_KEY=base64:ae1QHf6uD8bQ/fGXtVNRRdqZTAVanCyh7/r8S09QSdw=
APP_DEBUG=true

# MySQL Testing Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=policyflow_testing
DB_USERNAME=policyflow
DB_PASSWORD=secret

# PostgreSQL Alternative
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=policyflow_testing
# DB_USERNAME=policyflow
# DB_PASSWORD=secret

QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array

POLICYFLOW_SUBMISSION_LEASE_SECONDS=120
POLICYFLOW_MAX_SUBMISSION_ATTEMPTS=3
POLICYFLOW_RECONCILE_INLINE_ON_TIMEOUT=true
MOCK_SCENARIO_ALLOWED=true
