APP_NAME=PolicyFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - Default MySQL 8 (matching docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=policyflow
DB_USERNAME=policyflow
DB_PASSWORD=secret

# Database - Alternative PostgreSQL 15+
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=policyflow
# DB_USERNAME=policyflow
# DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

# PolicyFlow Engine Configuration
POLICYFLOW_SUBMISSION_LEASE_SECONDS=120
POLICYFLOW_MAX_SUBMISSION_ATTEMPTS=3
POLICYFLOW_RECONCILE_INLINE_ON_TIMEOUT=true

# Mock Insurer Configuration
MOCK_INSURER_TEMPORARY_FAILURE_ATTEMPTS=1
MOCK_INSURER_DUPLICATE_CALLBACK_DELIVERIES=3
MOCK_SCENARIO_ALLOWED=true
